# Supabase — get from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football (free tier, 100 req/day) — https://www.api-football.com/
API_FOOTBALL_KEY=your-api-football-key

# Google Gemini — used by Futbolpedia outlook generation (server-only)
API_KEY=your-gemini-api-key

# Secret for protecting cron/admin API routes — generate with: openssl rand -base64 32
CRON_SECRET=your-random-secret

# Comma-separated allowlist of emails allowed to access platform-wide admin
# pages (e.g. /admin/offseason), distinct from any league's commissioner.
ADMIN_EMAILS=you@example.com

# Web Push (VAPID) — generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
