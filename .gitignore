# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp/dev scripts
tmp_*.ts
tmp_*.js
*.log

# Cursor IDE local config (may contain API keys)
.cursor/

# context backups
backup_docs/

# design-sync (claude.ai/design) — staged converter + generated build output
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Playwright persistent browser profile used by the SoFIFA/Transfermarkt
# scrapers (chromium.launchPersistentContext). Pure runtime cache — ~130MB
# that churns on every scraper run. Playwright recreates it automatically.
playwright-profile/
